# Copy to .env only for live demo; never commit real keys.
DRY_RUN=1
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Key material: prefer SOLANA_KEYPAIR_PATH for local agent wallet; never commit real keys.
SOLANA_KEYPAIR_PATH=/home/ubuntu/bounty-work/oobe-wallet/solana-mainnet-agent-keypair.json
# SOLANA_PRIVATE_KEY may be base58 or a JSON secret-key array; leave unset when using SOLANA_KEYPAIR_PATH.
SOLANA_PRIVATE_KEY=
# Optional OOBE/Synapse paid upstream RPC/API key, if not using public RPC
SYNAPSE_RPC_URL=
SYNAPSE_API_KEY=
# Public URL where the autonomous agent service will be reachable after deployment
AGENT_PUBLIC_URL=https://example.invalid/oobe-ace-agent
# Spend guards: live code refuses SAP registration if HARD_CAP_SOL is below MIN_SAP_REGISTER_SOL.
HARD_CAP_SOL=0.05
MIN_SAP_REGISTER_SOL=0.1
# Ace x402 network: solana is most aligned with SAP mainnet; base/skale possible for Ace only
ACE_X402_NETWORK=solana
MAX_USDC_MICRO=200000
